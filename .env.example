# Optional. Docker Compose has working defaults and needs no .env file.
# Copy to .env only when you want to override the defaults, then edit it.
DEBUG=0

# Comma separated. Use your LAN hostname/IP if you open the portal from another device.
ALLOWED_HOSTS=localhost,127.0.0.1,datasnapper.local
# Required when serving over HTTPS, e.g. https://datasnapper.example.com
CSRF_TRUSTED_ORIGINS=

# Leave empty to generate and persist keys in /data on first start.
SECRET_KEY=
FIELD_ENCRYPTION_KEY=

TIME_ZONE=Europe/Amsterdam
LANGUAGE_CODE=en

# Created on first start when no user exists.
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-long-password

# Only enable when the portal is behind HTTPS.
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0

DATA_DIR=/data
LOG_LEVEL=INFO
GUNICORN_TIMEOUT=180

# Optional AI assistance. Disabled until LLM_ENABLED=1 or enabled in Settings.
# Local Ollama: LLM_BASE_URL=http://host.docker.internal:11434 (host)
#               or http://ollama:11434 (Compose service).
LLM_ENABLED=0
LLM_PROVIDER=ollama
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=120
LLM_MAX_OUTPUT_TOKENS=1500
LLM_REASONING=0
LLM_SHARE_PERSONAL_DATA=0

# API keys are read from the environment only and never stored in the database.
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# OpenAI or another OpenAI-compatible provider.
OPENAI_API_KEY=
# Generic fallback for compatible providers such as OpenRouter.
LLM_API_KEY=
